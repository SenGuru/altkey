<table>
<thead><tr><th>Method</th><th>Path</th><th>Auth</th><th>Notes</th></tr></thead>
<tbody>
<tr><td>GET</td><td><code>/v1/models</code></td><td>Bearer</td><td>OpenAI-shape model list</td></tr>
<tr><td>POST</td><td><code>/v1/chat/completions</code></td><td>Bearer</td><td>Streaming + non-streaming</td></tr>
<tr><td>GET</td><td><code>/canary.txt</code></td><td>none</td><td>Warrant canary</td></tr>
</tbody>
